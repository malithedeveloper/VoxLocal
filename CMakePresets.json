{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VOXLOCAL_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "tests",
      "displayName": "Core tests only",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOXLOCAL_BUILD_PLUGIN": "OFF",
        "VOXLOCAL_BUILD_TESTS": "ON",
        "VOXLOCAL_ENABLE_ONNX": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "tests", "configurePreset": "tests" }
  ],
  "testPresets": [
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "tests", "configurePreset": "tests", "output": { "outputOnFailure": true } }
  ]
}
