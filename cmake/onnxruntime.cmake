include(FetchContent)

function(voxlocal_fetch_onnxruntime)
  if(WIN32)
    set(_ort_url "https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime.directml/1.24.4/microsoft.ml.onnxruntime.directml.1.24.4.nupkg")
    set(_ort_hash "57e9f11b73437bef7a309496135d4c1f96b1a8e9ddba60013fa27bfc1d788681")
    set(_ort_include_suffix "build/native/include")
    set(_ort_library_suffix "runtimes/win-x64/native")
    set(_ort_directml ON)
  elseif(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
    set(_ort_url "https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-osx-arm64-1.23.2.tgz")
    set(_ort_hash "b4d513ab2b26f088c66891dbbc1408166708773d7cc4163de7bdca0e9bbb7856")
    set(_ort_include_suffix "include")
    set(_ort_library_suffix "lib")
  elseif(APPLE)
    set(_ort_url "https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-osx-x86_64-1.23.2.tgz")
    set(_ort_hash "d10359e16347b57d9959f7e80a225a5b4a66ed7d7e007274a15cae86836485a6")
    set(_ort_include_suffix "include")
    set(_ort_library_suffix "lib")
  elseif(UNIX AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    set(_ort_url "https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-linux-x64-1.23.2.tgz")
    set(_ort_hash "1fa4dcaef22f6f7d5cd81b28c2800414350c10116f5fdd46a2160082551c5f9b")
    set(_ort_include_suffix "include")
    set(_ort_library_suffix "lib")
  else()
    message(FATAL_ERROR "No pinned ONNX Runtime binary is available for ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}. Set ONNXRUNTIME_ROOT to a compatible build.")
  endif()

  FetchContent_Declare(voxlocal_onnxruntime
    URL "${_ort_url}"
    URL_HASH "SHA256=${_ort_hash}"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(voxlocal_onnxruntime)
  set(ONNXRUNTIME_INCLUDE_DIR "${voxlocal_onnxruntime_SOURCE_DIR}/${_ort_include_suffix}" PARENT_SCOPE)
  set(ONNXRUNTIME_LIBRARY_DIR "${voxlocal_onnxruntime_SOURCE_DIR}/${_ort_library_suffix}" PARENT_SCOPE)
  if(_ort_directml)
    set(VOXLOCAL_ORT_DIRECTML ON PARENT_SCOPE)
  endif()
endfunction()
